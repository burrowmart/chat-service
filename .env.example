# Server
PORT=3000
NODE_ENV=development

# MongoDB — use the platform-infra compose stack for local dev
# docker compose -f ../platform-infra/docker-compose.yml up -d mongo
MONGO_URI=mongodb://localhost:27017/chat-service

# Redis — pub/sub fan-out (chat:{conversationId}) + presence/typing TTL keys
REDIS_URL=redis://localhost:6379

# Auth
# AUTH_DISABLED=true skips identity extraction (tests/local dev).
# Signature verification lives in the Envoy PEP, not in the app.
AUTH_DISABLED=false

# Observability — OpenTelemetry
# Leave blank to use ConsoleSpanExporter (prints to stdout) for local dev
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=chat-service
